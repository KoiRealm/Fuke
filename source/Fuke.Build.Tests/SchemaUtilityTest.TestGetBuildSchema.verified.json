{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "$ref": "#/definitions/build",
  "title": "Build Schema",
  "definitions": {
    "build": {
      "type": "object",
      "properties": {
        "BooleanParam": {
          "type": "boolean"
        },
        "ComplexTypeArrayParam": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ComplexTypeParam": {
          "type": "string"
        },
        "ComponentInheritedParam": {
          "type": "string"
        },
        "Continue": {
          "type": "boolean",
          "description": "Continue the previous failed build."
        },
        "CustomEnumerationArrayParam": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Debug",
              "Release"
            ]
          }
        },
        "CustomEnumerationParam": {
          "type": "string",
          "enum": [
            "Debug",
            "Release"
          ]
        },
        "Help": {
          "type": "boolean",
          "description": "Show help for this build assembly."
        },
        "Host": {
          "type": "string",
          "description": "Execution host. Defaults to 'automatic'."
        },
        "IntegerArrayParam": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "NoLogo": {
          "type": "boolean",
          "description": "Suppress the FUKE header and ASCII logo, and use compact build output."
        },
        "NullableBooleanParam": {
          "type": "boolean"
        },
        "Partition": {
          "type": "string",
          "description": "Partition used on CI."
        },
        "Plan": {
          "type": "boolean",
          "description": "Show the execution plan as HTML."
        },
        "Profile": {
          "type": "array",
          "description": "Profiles to load.",
          "items": {
            "type": "string"
          }
        },
        "RegularParam": {
          "type": "string"
        },
        "Root": {
          "type": "string",
          "description": "Root directory used during build execution."
        },
        "SecretParam": {
          "type": "string",
          "default": "Enter the secret through 'fuke :secrets [profile]'."
        },
        "Skip": {
          "type": "array",
          "description": "List of targets to skip. An empty list skips all dependencies.",
          "items": {
            "type": "string"
          }
        },
        "StringArrayParam": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "Target": {
          "type": "array",
          "description": "List of targets to invoke. Defaults to '{default_target}'.",
          "items": {
            "type": "string"
          }
        },
        "Verbosity": {
          "type": "string",
          "description": "Logging verbosity during build execution. Defaults to 'Normal'.",
          "enum": [
            "Minimal",
            "Normal",
            "Quiet",
            "Verbose"
          ]
        }
      }
    }
  }
}
