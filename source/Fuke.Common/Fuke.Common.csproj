<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="CI\TeamCity\Configuration\pom.xml" />
    <!--<None Remove="execution-plan.html" />-->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fuke.Build\Fuke.Build.csproj" />
    <ProjectReference Include="..\Fuke.Build.Shared\Fuke.Build.Shared.csproj" />
    <ProjectReference Include="..\Fuke.ProjectModel\Fuke.ProjectModel.csproj" />
    <ProjectReference Include="..\Fuke.SolutionModel\Fuke.SolutionModel.csproj" />
    <ProjectReference Include="..\Fuke.Tooling\Fuke.Tooling.csproj" />
    <ProjectReference Include="..\Fuke.Utilities\Fuke.Utilities.csproj" />
    <ProjectReference Include="..\Fuke.Utilities.IO.Compression\Fuke.Utilities.IO.Compression.csproj" />
    <ProjectReference Include="..\Fuke.Utilities.IO.Globbing\Fuke.Utilities.IO.Globbing.csproj" />
    <ProjectReference Include="..\Fuke.Utilities.Net\Fuke.Utilities.Net.csproj" />
    <ProjectReference Include="..\Fuke.Utilities.Text.Json\Fuke.Utilities.Text.Json.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Security.KeyVault.Certificates" />
    <PackageReference Include="Azure.Security.KeyVault.Keys" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
    <PackageReference Include="Octokit" />
  </ItemGroup>

  <ItemGroup Condition="'$(_IsPacking)' == 'True'">
    <None Include="$(MSBuildProjectName).props" PackagePath="build" Pack="true" />
    <None Include="$(MSBuildProjectName).targets" PackagePath="build" Pack="true" />
    <None Include="..\Fuke.MSBuildTasks\Fuke.MSBuildTasks.targets" PackagePath="build\netcore" Pack="true" />
    <None Include="..\Fuke.MSBuildTasks\Fuke.MSBuildTasks.targets" PackagePath="build\netfx" Pack="true" />
    <None Include="..\Fuke.MSBuildTasks\bin\$(Configuration)\net10.0\publish\**\*.*" PackagePath="build\netcore" Pack="true" />
    <None Include="..\Fuke.MSBuildTasks\bin\$(Configuration)\net472\publish\**\*.*" PackagePath="build\netfx" Pack="true" />
    <None Include="..\Fuke.SourceGenerators\bin\$(Configuration)\netstandard2.0\*.dll" PackagePath="analyzers\dotnet\cs" Pack="true" />
  </ItemGroup>

</Project>
