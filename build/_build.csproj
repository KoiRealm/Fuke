  <PropertyGroup>
    <DefineConstants>$(Configuration.ToUpper())</DefineConstants>
    <DefineConstants Condition="'$(OS)' == 'Windows_NT'">$(DefineConstants);WIN</DefineConstants>
    <DefineConstants Condition="'$(OS)' != 'Windows_NT'">$(DefineConstants);UNIX</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="linqtotwitter" Version="6.15.0" />
    <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
    <!-- 3.x requires a paid Six Labors license; 2.1.7 is the newest compatible OSS release. -->
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
    <PackageDownload Include="Codecov.Tool" Version="[1.13.0]" />
    <PackageDownload Include="GitVersion.Tool" Version="[6.8.2]" />
    <PackageDownload Include="JetBrains.ReSharper.GlobalTools" Version="[2026.2.1]" />
    <PackageDownload Include="ReportGenerator" Version="[5.5.11]" />
    <!-- Compatibility fixture for the public xUnit v2 tool wrapper; repository tests run on xUnit v3. -->
    <PackageDownload Include="xunit.runner.console" Version="[2.9.3]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\source\Fuke.Components\Fuke.Components.csproj" />
    <ProjectReference Include="..\source\Fuke.Tooling.Generator\Fuke.Tooling.Generator.csproj" />
    <ProjectReference Include="..\source\Fuke.SourceGenerators\Fuke.SourceGenerators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
  </ItemGroup>

  <Import Project="..\source\Fuke.Common\Fuke.Common.targets" />

</Project>
