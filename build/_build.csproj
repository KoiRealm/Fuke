<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Version.props" />
  <Import Project="..\source\Fuke.Common\Fuke.Common.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <RootNamespace></RootNamespace>
    <NoWarn>CS0649;CS0169</NoWarn>
    <FukeRootDirectory>.\..</FukeRootDirectory>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Test properties for MSBuild integration -->
  <PropertyGroup>
    <FukeTasksEnabled Condition="'$(FukeTasksEnabled)' == ''">False</FukeTasksEnabled>
    <FukeTasksDirectory>$(MSBuildThisFileDirectory)\..\source\Fuke.MSBuildTasks\bin\Debug\net8.0\publish</FukeTasksDirectory>

<!--    <PackAsTool>True</PackAsTool>-->
