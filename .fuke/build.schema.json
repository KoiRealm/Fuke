{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "definitions": {
    "Host": {
      "type": "string",
      "enum": [
        "AppVeyor",
        "AzurePipelines",
        "Bamboo",
        "Bitbucket",
        "Bitrise",
        "GitHubActions",
        "GitLab",
        "Jenkins",
        "Rider",
        "SpaceAutomation",
        "TeamCity",
        "Terminal",
        "TravisCI",
        "VisualStudio",
        "VSCode"
      ]
    },
    "SignPathSettings": {
      "type": "object",
      "properties": {
        "OrganizationId": {
          "type": [
            "null",
            "string"
          ]
        },
        "ProjectSlug": {
          "type": [
            "null",
            "string"
          ]
        },
        "PolicySlug": {
          "type": [
            "null",
            "string"
          ]
        }
      }
    },
    "ExecutableTarget": {
      "type": "string",
      "enum": [
        "Announce",
        "AnnounceDiscord",
        "AnnounceMastodon",
        "AnnounceSlack",
        "AnnounceTwitter",
        "Changelog",
        "CheckoutExternalRepositories",
        "Clean",
        "Compile",
        "CreateGitHubRelease",
        "DeletePackages",
        "DownloadLicenses",
        "GeneratePublicApi",
        "GenerateTools",
        "Hotfix",
        "Install",
        "InstallFonts",
        "Milestone",
        "Pack",
        "Publish",
        "References",
        "Release",
        "ReleaseImage",
        "ReportCoverage",
        "ReportDuplicates",
        "ReportIssues",
        "Restore",
        "RunTargetInDockerImageTest",
        "SignPackages",
        "Test",
        "UpdateContributors",
        "UpdateStargazers"
      ]
    },
    "Verbosity": {
      "type": "string",
      "description": "",
      "enum": [
        "Verbose",
        "Normal",
        "Minimal",
        "Quiet"
      ]
    },
    "FukeBuild": {
      "properties": {
        "Continue": {
          "type": "boolean",
          "description": "Continue the previous failed build."
        },
        "Help": {
          "type": "boolean",
          "description": "Show help for this build assembly."
        },
        "Host": {
          "description": "Execution host. Defaults to 'automatic'.",
          "$ref": "#/definitions/Host"
        },
        "NoLogo": {
          "type": "boolean",
          "description": "Suppress the FUKE header and ASCII logo, and use compact build output."
        },
        "Partition": {
          "type": "string",
          "description": "Partition used on CI."
        },
        "Plan": {
          "type": "boolean",
          "description": "Show the execution plan as HTML."
        },
        "Profile": {
          "type": "array",
          "description": "Profiles to load.",
          "items": {
            "type": "string"
          }
        },
        "Root": {
          "type": "string",
          "description": "Root directory used during build execution."
        },
        "Skip": {
          "type": "array",
          "description": "List of targets to skip. An empty list skips all dependencies.",
          "items": {
            "$ref": "#/definitions/ExecutableTarget"
          }
        },
        "Target": {
          "type": "array",
          "description": "List of targets to invoke. Defaults to '{default_target}'.",
          "items": {
            "$ref": "#/definitions/ExecutableTarget"
          }
        },
        "Verbosity": {
          "description": "Logging verbosity during build execution. Defaults to 'Normal'.",
          "$ref": "#/definitions/Verbosity"
        }
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "AutoStash": {
          "type": "boolean"
        },
        "CodecovToken": {
          "type": "string",
          "default": "Enter the secret through 'fuke :secrets [profile]'."
        },
        "Configuration": {
          "type": "string",
          "enum": [
            "Debug",
            "Release"
          ]
        },
        "DiscordWebhook": {
          "type": "string",
          "default": "Enter the secret through 'fuke :secrets [profile]'."
        },
        "GitHubReleaseGitHubToken": {
          "type": "string",
          "default": "Enter the secret through 'fuke :secrets [profile]'."
        },
        "IgnoreFailedSources": {
          "type": "boolean",
          "description": "Ignore inaccessible sources during Restore"
        },
        "MastodonAccessToken": {
          "type": "string",
          "default": "Enter the secret through 'fuke :secrets [profile]'."
        },
        "PrereleaseNuGetApiKey": {
          "type": "string",
          "description": "NuGet API key used to publish prerelease packages.",
          "default": "Enter the secret through 'fuke :secrets [profile]'."
        },
        "PrereleaseNuGetSource": {
          "type": "string",
          "description": "NuGet source for prerelease packages; it must be specified explicitly for non-stable releases."
        },
        "PublicNuGetApiKey": {
          "type": "string",
          "description": "NuGet API key used to publish stable packages.",
          "default": "Enter the secret through 'fuke :secrets [profile]'."
        },
        "SignPathApiToken": {
          "type": "string",
          "default": "Enter the secret through 'fuke :secrets [profile]'."
        },
        "SignPathSettings": {
          "$ref": "#/definitions/SignPathSettings"
        },
        "SlackWebhook": {
          "type": "string",
          "default": "Enter the secret through 'fuke :secrets [profile]'."
        },
        "Solution": {
          "type": "string",
          "description": "Path to the solution file to load automatically."
        },
        "TestDegreeOfParallelism": {
          "type": "integer",
          "format": "int32"
        },
        "TwitterAccessToken": {
          "type": "string",
          "default": "Enter the secret through 'fuke :secrets [profile]'."
        },
        "TwitterAccessTokenSecret": {
          "type": "string",
          "default": "Enter the secret through 'fuke :secrets [profile]'."
        },
        "TwitterConsumerKey": {
          "type": "string",
          "default": "Enter the secret through 'fuke :secrets [profile]'."
        },
        "TwitterConsumerSecret": {
          "type": "string",
          "default": "Enter the secret through 'fuke :secrets [profile]'."
        },
        "UseHttps": {
          "type": "boolean"
        }
      }
    },
    {
      "$ref": "#/definitions/FukeBuild"
    }
  ]
}
