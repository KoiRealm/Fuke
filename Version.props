<Project>
  <PropertyGroup>
    <!-- NuGet packages use SemVer; assembly and file versions remain numeric for prerelease builds. -->
    <FukeVersion>0.1.1</FukeVersion>
    <Version>$(FukeVersion)</Version>
    <PackageVersion>$(FukeVersion)</PackageVersion>
    <AssemblyVersion>0.1.1.0</AssemblyVersion>
    <FileVersion>0.1.1.0</FileVersion>
    <InformationalVersion>$(FukeVersion)</InformationalVersion>
  </PropertyGroup>
</Project>
